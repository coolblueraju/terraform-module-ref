resource "aws_cloudwatch_log_group" "ecs_task_logs" { name = "/umb/aws/${var.app_short_name}-ecs/${var.env}/${local.service_name}-LogGroup"; retention_in_days = 30; skip_destroy = true; tags = local.tags }
resource "aws_iam_role" "execution_role" { name="${local.service_name}-execution-role"; assume_role_policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Principal={Service="ecs-tasks.amazonaws.com"},Action="sts:AssumeRole"}]}); tags=local.tags }
resource "aws_iam_role_policy_attachment" "exec_ecs" { role=aws_iam_role.execution_role.name; policy_arn="arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" }
resource "aws_iam_role_policy_attachment" "exec_cw" { role=aws_iam_role.execution_role.name; policy_arn="arn:aws:iam::aws:policy/CloudWatchFullAccess" }
resource "aws_iam_role" "task_role" { name="${local.service_name}-task-role"; assume_role_policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Principal={Service="ecs-tasks.amazonaws.com"},Action="sts:AssumeRole"}]}); tags=local.tags }
resource "aws_iam_policy" "policy" {
  name="${var.app_short_name}-read-policy"
  policy=jsonencode({Version="2012-10-17",Statement=concat([
    {Sid="Secrets",Effect="Allow",Action=["secretsmanager:GetSecretValue","secretsmanager:DescribeSecret"],Resource="arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:umb-aws-common-*"},
    {Sid="Parameters",Effect="Allow",Action=["ssm:GetParameter","ssm:GetParameters","ssm:GetParametersByPath"],Resource="arn:aws:ssm:${var.aws_region}:${data.aws_caller_identity.current.account_id}:parameter/umb-aws-common/*"},
    {Sid="S3Data",Effect="Allow",Action=["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:ListBucket"],Resource=["arn:aws:s3:::${local.data_bucket_name}","arn:aws:s3:::${local.data_bucket_name}/*"]}
  ], var.grant_dynamodb_access && length(var.dynamodb_table_names)>0 ? [{Sid="DynamoDB",Effect="Allow",Action=var.dynamodb_access_actions,Resource=flatten([for n in distinct(var.dynamodb_table_names):["arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/${n}","arn:aws:dynamodb:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/${n}/index/*"]])}] : []))})
}
resource "aws_iam_role_policy_attachment" "task_policy" { role=aws_iam_role.task_role.name; policy_arn=aws_iam_policy.policy.arn }
resource "aws_security_group" "ecs_service_sg" { name=local.sg_name; vpc_id=data.aws_vpc.default.id; tags=local.tags }
resource "aws_security_group_rule" "ingress_alb" { type="ingress"; from_port=var.port; to_port=var.port; protocol="tcp"; source_security_group_id=tolist(data.aws_lb.shared.security_groups)[0]; security_group_id=aws_security_group.ecs_service_sg.id }
resource "aws_security_group_rule" "egress" { type="egress"; from_port=0; to_port=0; protocol="-1"; cidr_blocks=["0.0.0.0/0"]; security_group_id=aws_security_group.ecs_service_sg.id }
resource "aws_lb_target_group" "alb_target_group" { name=local.target_group_name; port=443; protocol="HTTPS"; vpc_id=data.aws_vpc.default.id; target_type="ip"; health_check { path=var.health_check_path; protocol="HTTPS"; port=tostring(var.port) }; tags=local.tags }
resource "aws_lb_listener_rule" "https_rule" { listener_arn=data.aws_lb_listener.https.arn; action { type="forward"; target_group_arn=aws_lb_target_group.alb_target_group.arn }; condition { path_pattern { values=[var.lister_rule_uri_pattern] } } }
resource "aws_ecs_task_definition" "ecs_task" { family=local.service_name; network_mode="awsvpc"; requires_compatibilities=["FARGATE"]; cpu=var.cpu; memory=var.memory; execution_role_arn=aws_iam_role.execution_role.arn; task_role_arn=aws_iam_role.task_role.arn; container_definitions=jsonencode([{name=local.service_name,image="${data.aws_ecr_repository.service_repo.repository_url}@${data.aws_ecr_image.service_image.image_digest}",essential=true,portMappings=[{containerPort=var.port}],environment=local.env_list,logConfiguration={logDriver="awslogs",options={"awslogs-group"=aws_cloudwatch_log_group.ecs_task_logs.name,"awslogs-region"=var.aws_region,"awslogs-stream-prefix"="ecs"}}}]); tags=local.tags }
resource "aws_ecs_service" "service" { name=local.service_name; cluster=local.cluster_name; task_definition=aws_ecs_task_definition.ecs_task.arn; desired_count=var.min_capacity; force_new_deployment=true; enable_execute_command=true; deployment_circuit_breaker { enable=true; rollback=true }; network_configuration { subnets=data.aws_subnets.private.ids; security_groups=[aws_security_group.ecs_service_sg.id]; assign_public_ip=false }; load_balancer { target_group_arn=aws_lb_target_group.alb_target_group.arn; container_name=local.service_name; container_port=var.port }; depends_on=[aws_lb_listener_rule.https_rule]; tags=local.tags; lifecycle { precondition { condition=local.compliant_env != null; error_message="terraform.workspace must be test, qa, or prod." }; precondition { condition=length(data.aws_subnets.private.ids)>0; error_message="No private subnets found in default VPC." } } }
resource "aws_appautoscaling_target" "ecs_target" { max_capacity=var.max_capacity; min_capacity=var.min_capacity; resource_id="service/${local.cluster_name}/${aws_ecs_service.service.name}"; scalable_dimension="ecs:service:DesiredCount"; service_namespace="ecs" }
resource "aws_appautoscaling_policy" "ecs_target_cpu" { name="${local.service_name}-cpu"; policy_type="TargetTrackingScaling"; resource_id=aws_appautoscaling_target.ecs_target.resource_id; scalable_dimension=aws_appautoscaling_target.ecs_target.scalable_dimension; service_namespace=aws_appautoscaling_target.ecs_target.service_namespace; target_tracking_scaling_policy_configuration { target_value=var.ALBAvgCPUPerTarget; predefined_metric_specification { predefined_metric_type="ECSServiceAverageCPUUtilization" } } }
