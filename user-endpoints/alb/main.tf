resource "aws_security_group" "alb_sg" { name=local.sg_name; vpc_id=data.aws_vpc.default.id; tags=local.tags }
resource "aws_security_group_rule" "ingress" { for_each=var.trusted_ip_ranges; type="ingress"; from_port=443; to_port=443; protocol="tcp"; cidr_blocks=[each.value.cidr]; description=each.value.description; security_group_id=aws_security_group.alb_sg.id }
resource "aws_security_group_rule" "egress" { type="egress"; from_port=0; to_port=0; protocol="-1"; cidr_blocks=["0.0.0.0/0"]; security_group_id=aws_security_group.alb_sg.id }
resource "aws_lb_trust_store" "mtls_trust_store" { count=var.enable_mtls && var.mtls_create_trust_store?1:0; name=local.trust_store_name; ca_certificates_bundle_s3_bucket=var.mtls_trust_store_s3_bucket; ca_certificates_bundle_s3_key=var.mtls_trust_store_s3_bucket_path; tags=local.tags }
resource "aws_lb" "alb_load_balancer" { name=local.name; internal=var.alb_type!="public"; load_balancer_type="application"; security_groups=[aws_security_group.alb_sg.id]; subnets=local.subnets; enable_deletion_protection=true; tags=local.tags; lifecycle { precondition { condition=local.compliant_env!=null; error_message="workspace must be test, qa, or prod." }; precondition { condition=length(local.subnets)>=2; error_message="At least two matching ALB subnets are required." } } }
resource "aws_lb_listener" "alb_listener_https" { load_balancer_arn=aws_lb.alb_load_balancer.arn; port=443; protocol="HTTPS"; certificate_arn=var.cert_arn; ssl_policy="ELBSecurityPolicy-TLS13-1-2-2021-06"; dynamic "mutual_authentication" { for_each=var.enable_mtls?[1]:[]; content { mode=var.mtls_mode; trust_store_arn=var.mtls_mode=="verify"?aws_lb_trust_store.mtls_trust_store[0].arn:null } }; default_action { type="fixed-response"; fixed_response { content_type="text/plain"; message_body="Not Found"; status_code="404" } }; lifecycle { precondition { condition=!var.enable_mtls || var.mtls_mode!="verify" || (var.mtls_create_trust_store && var.mtls_trust_store_s3_bucket!=null && var.mtls_trust_store_s3_bucket_path!=null); error_message="mTLS verify requires trust store creation and S3 CA bundle inputs." } } }
resource "aws_lb_target_group" "vpce_target_group" { count=var.vpce_eni_ips!=null && contains(["public","private"],var.alb_type)?1:0; name=substr("${var.alb_short_name}-${var.alb_type}-vpce-tg",0,32); port=443; protocol="HTTPS"; target_type="ip"; vpc_id=data.aws_vpc.default.id; health_check { path="/"; protocol="HTTPS"; matcher="200-499" }; tags=local.tags }
resource "aws_lb_target_group_attachment" "vpce" { for_each=var.vpce_eni_ips!=null && contains(["public","private"],var.alb_type)?toset(var.vpce_eni_ips):toset([]); target_group_arn=aws_lb_target_group.vpce_target_group[0].arn; target_id=each.value; port=443 }
resource "aws_lb_listener_rule" "vpce" { count=var.vpce_eni_ips!=null && contains(["public","private"],var.alb_type)?1:0; listener_arn=aws_lb_listener.alb_listener_https.arn; priority=50; action { type="forward"; target_group_arn=aws_lb_target_group.vpce_target_group[0].arn }; condition { path_pattern { values=["/*"] } } }
resource "aws_lb_target_group" "internal_pass_through" { for_each=var.alb_type=="internal"?local.tgmap:{}; name=substr("${var.alb_short_name}-${each.key}-tg",0,32); port=443; protocol="HTTPS"; target_type="ip"; vpc_id=data.aws_vpc.default.id; health_check { path="/"; protocol="HTTPS"; matcher="200-499" }; tags=local.tags }
locals { internal_targets=flatten([for name,tg in local.tgmap:[for t in tg.targets:{key="${name}-${t.ip}",name=name,ip=t.ip,az=t.availability_zone}]]) }
resource "aws_lb_target_group_attachment" "internal" { for_each=var.alb_type=="internal"?{for t in local.internal_targets:t.key=>t}:{}; target_group_arn=aws_lb_target_group.internal_pass_through[each.value.name].arn; target_id=each.value.ip; availability_zone=each.value.az; port=443 }
resource "aws_lb_listener_rule" "internal" { for_each=var.alb_type=="internal"?local.tgmap:{}; listener_arn=aws_lb_listener.alb_listener_https.arn; priority=each.value.priority; action { type="forward"; target_group_arn=aws_lb_target_group.internal_pass_through[each.key].arn }; condition { path_pattern { values=["/${each.key}/*"] } } }
