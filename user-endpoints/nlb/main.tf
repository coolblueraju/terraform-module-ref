resource "aws_security_group" "nlb_sg" { name="${var.alb_short_name}-vpclink-nlb-sg"; vpc_id=data.aws_vpc.default.id; ingress { from_port=443; to_port=443; protocol="tcp"; cidr_blocks=["0.0.0.0/0"] }; egress { from_port=0; to_port=0; protocol="-1"; cidr_blocks=["0.0.0.0/0"] }; tags=local.tags }
resource "aws_lb" "nlb_load_balancer" { name="${var.alb_short_name}-vpclink-nlb"; internal=true; load_balancer_type="network"; security_groups=[aws_security_group.nlb_sg.id]; subnet_mapping { subnet_id=local.subnets[0]; private_ipv4_address=var.nlb_staticips[0] }; subnet_mapping { subnet_id=local.subnets[1]; private_ipv4_address=var.nlb_staticips[1] }; subnet_mapping { subnet_id=local.subnets[2]; private_ipv4_address=var.nlb_staticips[2] }; tags=local.tags; lifecycle { precondition { condition=local.compliant_env!=null; error_message="workspace must be test, qa, or prod." }; precondition { condition=length(local.subnets)==3; error_message="Exactly 3 VPC Link subnets are required." } } }
resource "aws_lb_target_group" "nlb_target_group" { name=substr("${var.alb_short_name}-internal-alb-tg",0,32); port=443; protocol="TCP"; target_type="alb"; vpc_id=data.aws_vpc.default.id; health_check { protocol="HTTPS"; port="443"; path="/"; matcher="200,404" }; tags=local.tags }
resource "aws_lb_listener" "nlb_listener" { load_balancer_arn=aws_lb.nlb_load_balancer.arn; port=443; protocol="TCP"; default_action { type="forward"; target_group_arn=aws_lb_target_group.nlb_target_group.arn } }
resource "aws_lb_target_group_attachment" "tg_attachment" { target_group_arn=aws_lb_target_group.nlb_target_group.arn; target_id=data.aws_lb.alb.arn; port=443 }
