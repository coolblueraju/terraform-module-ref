locals { envmap={test="dev",qa="qa",prod="prod"}; compliant_env=lookup(local.envmap,terraform.workspace,null); private_domain="api-internal.services.${local.compliant_env}.aws.umb.com"; public_domain="api.${local.compliant_env}.umb.com"; tags=merge({umbAppName=var.alb_short_name,umbEnvironment=local.compliant_env,umbApplicationOwner=var.application_owner_email,umbProjectRITM=var.project_ritm,umbGitRepository=var.git_repo_name,umbCMDBID=var.cmdb_id},var.apprepo_tags) }
resource "aws_security_group" "vpc_endpoint" { name="${var.alb_short_name}-vpce-sg"; vpc_id=data.aws_vpc.default.id; ingress { from_port=443; to_port=443; protocol="tcp"; cidr_blocks=[data.aws_vpc.default.cidr_block] }; egress { from_port=0; to_port=0; protocol="-1"; cidr_blocks=["0.0.0.0/0"] }; tags=local.tags }
resource "aws_vpc_endpoint" "this" { vpc_id=data.aws_vpc.default.id; service_name="com.amazonaws.${var.aws_region}.execute-api"; vpc_endpoint_type="Interface"; subnet_ids=data.aws_subnets.private.ids; security_group_ids=[aws_security_group.vpc_endpoint.id]; private_dns_enabled=true; policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Principal="*",Action="*",Resource="*"}]}); tags=merge(local.tags,{Name="${var.alb_short_name}-vpce"}); lifecycle { precondition { condition=local.compliant_env!=null; error_message="workspace must be test, qa, or prod." } } }
resource "aws_vpc_endpoint" "management_vpce" { vpc_id=data.aws_vpc.default.id; service_name="com.amazonaws.us-east-2.apigateway"; vpc_endpoint_type="Interface"; subnet_ids=data.aws_subnets.private.ids; security_group_ids=[aws_security_group.vpc_endpoint.id]; private_dns_enabled=true; policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Principal="*",Action="*",Resource="*"}]}); tags=local.tags }
resource "aws_api_gateway_domain_name" "private" { count=var.create_apigw_custom_domains?1:0; domain_name=local.private_domain; regional_certificate_arn=var.private_cert_arn; endpoint_configuration { types=["REGIONAL"] }; security_policy="TLS_1_2"; tags=local.tags; lifecycle { precondition { condition=var.private_cert_arn!=null && var.public_cert_arn!=null; error_message="Both private_cert_arn and public_cert_arn are required when custom domains are enabled." } } }
resource "aws_api_gateway_domain_name" "public" { count=var.create_apigw_custom_domains?1:0; domain_name=local.public_domain; regional_certificate_arn=var.public_cert_arn; endpoint_configuration { types=["REGIONAL"] }; security_policy="TLS_1_2"; tags=local.tags }
